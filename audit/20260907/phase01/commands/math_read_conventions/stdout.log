\bibitem{hutomo} J. Hutomo, K. Lechner, and D. P. Sorokin,
\emph{On non-linear chiral 4-form theories in D=10},
\href{https://arxiv.org/abs/2509.14351}{arXiv:2509.14351}.
\end{thebibliography}

