    80	def order8(out, cache_dir):
    81	    low = json.loads((ROOT / "results/10d_order8.json").read_text())
    82	    graph_items = [g for g in low["generators"] if g["order"] in (4, 8)]
    83	    primes, holdout = [32749, 32719, 32693, 32713, 32717], 32771
    84	    fit_seeds, fresh_seeds = list(range(2026090700, 2026090709)), [2026090801, 2026090802, 2026090803]
    85	    evidence = {}
    86	    sources = ["src/sdinv/published_degree8_invariants.py", "src/sdinv/stress.py",
    87	               "src/sdinv/contract.py", "src/sdinv/modp.py", "scripts/map_literature_basis.py"]
    88	    identity = digest({"graphs": graph_items, "sources": {s: (ROOT / s).read_bytes().hex() for s in sources}})
    89	    for p in primes + [holdout]:
    90	        cache = cache_dir / f"order8_p{p}.json"
    91	        data = json.loads(cache.read_text()) if cache.exists() else {"identity": identity, "prime": p, "samples": []}
    92	        if data["identity"] != identity:
    93	            raise ValueError("order-8 cache engine mismatch; use a new cache directory")
    94	        seeds = fit_seeds + fresh_seeds if p in primes else fresh_seeds
    95	        if [s["seed"] for s in data["samples"]] != seeds[:len(data["samples"])]:
    96	            raise ValueError("order-8 cache sample mismatch")
    97	        for seed in seeds[len(data["samples"]):]:
    98	            data["samples"].append(_sample8(p, seed, graph_items))
    99	            atomic_write_json(cache, data)
   100	            print(f"order8 p={p}: sample {len(data['samples'])}/{len(seeds)}", flush=True)
   101	        if p in primes:
   102	            design = np.array([s["graphs"] for s in data["samples"][:len(fit_seeds)]])
   103	            target = np.array([s["tensors"] for s in data["samples"][:len(fit_seeds)]])
   104	            data["tensor_to_graph_matrix_mod_p"] = [solve_full_column_rank(design, target[:, j], p).tolist() for j in range(7)]
   105	            data["graph_rank"] = rank_mod(design, p)
   106	            data["tensor_rank"] = rank_mod(target, p)
   107	        evidence[str(p)] = data
   108	    tensor_to_graph = [reconstruct_vector([evidence[str(p)]["tensor_to_graph_matrix_mod_p"][i] for p in primes], primes) for i in range(7)]
   109	    graph_to_tensor = inverse(tensor_to_graph)
   110	    for p in primes + [holdout]:
   111	        forward, backward = reduce_matrix(tensor_to_graph, p), reduce_matrix(graph_to_tensor, p)
   112	        for sample in evidence[str(p)]["samples"]:
   113	            g, t = np.array(sample["graphs"]), np.array(sample["tensors"])
   114	            if not np.array_equal(forward @ g % p, t) or not np.array_equal(backward @ t % p, g):
   115	                raise ValueError(f"order-8 holdout mismatch at prime {p}")
   116	    result = {"schema": 1, "degree": 8, "literature_source": SOURCE,
   117	              "literature_basis": BASIS, "graph_basis": graph_items[1:],
   118	              "basis_selection": "T8_1 through T8_5 from (4.12)--(4.15), and H8_1 from (4.18); this selection spans all seven degree-8 directions after adjoining the quartic square.",
   119	              "product": "I4_1^2 (repository normalization)",
   120	              "matrix_convention": "[G1,...,G6,P]^T = graph_to_literature * [T1,...,T6,P]^T",
   121	              "graph_to_literature": [[str(x) for x in row] for row in graph_to_tensor],
   122	              "literature_to_graph": [[str(x) for x in row] for row in tensor_to_graph],
   123	              "primitive_quotient_matrix_6x6": [[str(x) for x in row[:6]] for row in graph_to_tensor[:6]],
   124	              "product_correction": [str(row[6]) for row in graph_to_tensor[:6]],
   125	              "exact_6x6_without_products": all(row[6] == 0 for row in graph_to_tensor[:6]),
   126	              "fitting_primes": primes, "holdout_prime": holdout,
   127	              "verification_seeds": fresh_seeds, "prime_witnesses": evidence,
   128	              "verified": True,
   129	              "proof_scope": "Exact modular solves, unique bounded rational reconstruction and fresh value holdouts; polynomial identity validity over Q is not proved by finite samples alone."}
   130	    atomic_write_json(out, result)
   131	    print("PASS: order-8 rational map and fresh holdouts")
