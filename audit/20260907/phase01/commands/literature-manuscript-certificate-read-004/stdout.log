    69	def _sample8(prime, seed, graph_items):
    70	    a = np.random.default_rng(seed).integers(0, prime, 126).tolist()
    71	    form, _, _ = context(prime, a)
    72	    graph_values = [planned_value(graph_from_label(g["graph"]), form, 10, 5, True, prime)
    73	                    for g in graph_items]
    74	    quartic_squared = graph_values[0] ** 2 % prime
    75	    graphs = graph_values[1:] + [quartic_squared]
    76	    tensors = evaluate_selected_basis(form, prime) + [quartic_squared]
    77	    return {"seed": seed, "coordinates": a, "graphs": graphs, "tensors": tensors}
