    77	def main():
    78	    parser = argparse.ArgumentParser(description=__doc__)
    79	    parser.add_argument("--basis", default=str(ROOT / "results/rank81_basis.json"))
    80	    parser.add_argument("--out", default=str(ROOT / "results/rank81_certificate.json"))
    81	    parser.add_argument("--checkpoint-dir", type=Path, default=ROOT / "work/rank81")
    82	    parser.add_argument("--primes", type=int, nargs="+", default=[32749, 32719])
    83	    parser.add_argument("--seeds", type=int, nargs="+", default=[20260907, 20260908])
    84	    parser.add_argument("--workers", type=int, default=1)
    85	    args = parser.parse_args()
    86	    if args.workers < 1 or len(set(args.primes)) != len(args.primes) or len(set(args.seeds)) != len(args.seeds):
    87	        parser.error("workers must be positive and primes/seeds must be distinct")
    88	    manifest = json.loads(Path(args.basis).read_text())
    89	    validate_basis(manifest)
    90	    directions, indices = integral_directions()
    91	    certificate = {"schema": 1, "basis_sha256": digest(manifest),
    92	                   "coordinate_convention": "A_I = F_I for sorted 5-tuples I containing 0; F = sum_I A_I (e_I + *e_I).",
    93	                   "coordinate_component_indices": indices,
    94	                   "integral_directions_sha256": digest(directions.tolist()),
    95	                   "proof": "Each graph is an integer polynomial in A. A nonzero 81x81 Jacobian minor modulo a prime proves generic characteristic-zero rank at least 81. The known quotient dimension supplies the upper bound; this is not a full invariant-ring presentation or a global coordinate chart.",
    96	                   "upper_bound_source": "https://arxiv.org/abs/2509.14350v2",
    97	                   "planned_cells": [[p, s] for p in args.primes for s in args.seeds],
    98	                   "complete": False, "witnesses": []}
    99	    for prime, seed in certificate["planned_cells"]:
   100	        certificate["witnesses"].append(evaluate_cell(manifest, prime, seed, args.checkpoint_dir, args.workers))
   101	        atomic_write_json(args.out, certificate)
   102	    certificate["complete"] = True
   103	    atomic_write_json(args.out, certificate)
   104	    print(f"PASS: fixed 81 graphs, {len(certificate['witnesses'])} exact nonzero minors")
   105	
   106	
   107	if __name__ == "__main__":
   108	    main()
