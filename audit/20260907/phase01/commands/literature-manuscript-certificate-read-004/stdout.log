    95	def test_integral_jacobian_matches_finite_difference_directional_polynomial():
    96	    # Quartic directional derivative recovered independently by exact
    97	    # interpolation from five values (not a floating difference quotient).
    98	    from sdinv.contract import planned_value
    99	    from sdinv.exactmap import solve_full_column_rank
   100	    item = json.loads((ROOT / "results/10d_order8.json").read_text())["generators"][0]
   101	    graph = graph_from_label(item["graph"])
   102	    record = {"id": item["id"], "degree": 4, "graph": to_record(graph)}
   103	    prime = 32749
   104	    a = np.random.default_rng(178).integers(0, prime, 126)
   105	    direction = np.random.default_rng(179).integers(0, prime, 126)
   106	    evaluated = evaluate_item(record, prime, a)
   107	    values = []
   108	    for t in range(5):
   109	        form, _, _ = context(prime, (a + t * direction) % prime)
   110	        values.append(planned_value(graph, form, 10, 5, True, prime))
   111	    vandermonde = [[pow(t, k, prime) for k in range(5)] for t in range(5)]
   112	    coefficients = solve_full_column_rank(vandermonde, values, prime)
   113	    assert int(np.array(evaluated["jacobian_row"]) @ direction % prime) == coefficients[1]
