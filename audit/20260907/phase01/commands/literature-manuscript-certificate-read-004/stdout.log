   164	def main():
   165	    parser = argparse.ArgumentParser(description=__doc__)
   166	    parser.add_argument("--degree", type=int, choices=[8, 10], required=True)
   167	    parser.add_argument("--out")
   168	    parser.add_argument("--cache-dir", type=Path, default=ROOT / "work/literature-maps")
   169	    args = parser.parse_args()
   170	    out = args.out or ROOT / f"results/order{args.degree}_change_of_basis.json"
   171	    if args.degree == 8:
   172	        order8(out, args.cache_dir)
   173	    else:
   174	        order10(out)
   175	
   176	
   177	if __name__ == "__main__":
   178	    main()
