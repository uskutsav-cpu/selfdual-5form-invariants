    88	def test_determinant_handles_row_swaps_and_singular_matrices():
    89	    assert determinant_mod([[0, 2], [3, 4]], 32749) == 32743
    90	    assert determinant_mod([[2, 4], [3, 6]], 32749) == 0
    91	    with pytest.raises(ValueError, match="prime"):
    92	        determinant_mod([[1]], 32745)
