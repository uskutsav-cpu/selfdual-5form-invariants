   134	def order10(out):
   135	    source = ROOT / "results/degree10/B10_coordinates_per_prime.json"
   136	    store = json.loads(source.read_text())["per_prime"]
   137	    primes = sorted(map(int, store))
   138	    fit, holdout = primes[:-1], primes[-1]
   139	    names = store[str(primes[0])]["basis"]
   140	    ids = sorted(store[str(primes[0])]["coordinates"])
   141	    matrices = [reconstruct_vector([store[str(p)]["coordinates"][cid] for p in fit], fit) for cid in ids]
   142	    reduced = reduce_matrix(matrices, holdout)
   143	    if reduced.tolist() != [store[str(holdout)]["coordinates"][cid] for cid in ids]:
   144	        raise ValueError("degree-10 held-out prime does not match rational reconstruction")
   145	    products = [[int(i == j) for i in range(len(names))] for j, name in enumerate(names) if "*" in name]
   146	    b_rank, p_rank, union_rank = rational_rank(matrices), rational_rank(products), rational_rank(matrices + products)
   147	    result = {"schema": 1, "degree": 10,
   148	              "status": "requested invertible 12x12 map does not exist for the implemented source readings",
   149	              "literature_basis": ids, "graph_and_product_basis": names,
   150	              "matrix_convention": "T_i = sum_j matrix[i][j] * atlas_j",
   151	              "matrix_12x14": [[str(x) for x in row] for row in matrices],
   152	              "published_span_rank": b_rank, "product_span_rank": p_rank,
   153	              "union_rank": union_rank, "intersection_rank": b_rank + p_rank - union_rank,
   154	              "primitive_quotient_rank": union_rank - p_rank,
   155	              "fitting_primes": fit, "holdout_prime": holdout,
   156	              "prime_witnesses": store, "verified_reconstruction": True,
   157	              "source_artifact": str(source.relative_to(ROOT)), "source_sha256": digest(json.loads(source.read_text())),
   158	              "source_readings": "See src/sdinv/published_degree10_invariants.py and docs/PUBLISHED_DEGREE10_INDEX_AUDIT.md; AMB-01/AMB-02 readings remain explicit.",
   159	              "proof_scope": "Rational matrix ranks are exact. Inherited polynomial maps were fitted and checked on finite samples; this regeneration checks arithmetic and a held-out prime, not new tensor evaluations."}
   160	    atomic_write_json(out, result)
   161	    print(f"PASS: degree-10 rational map has ranks published={b_rank}, products={p_rank}, union={union_rank}")
   162	
