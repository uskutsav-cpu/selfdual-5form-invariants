    25	def _regular_graph(n):
    26	    matrix = np.zeros((n, n), dtype=np.int64)
    27	    for i in range(n):
    28	        for d in (-2, -1, 1, 2, n // 2):
    29	            matrix[i, (i + d) % n] = 1
    30	    return matrix
