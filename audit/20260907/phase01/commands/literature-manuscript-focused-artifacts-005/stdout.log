    63	def evaluate_basis(form, prime):
    64	    lower, mixed = five_form_moment(form, prime)
    65	    upper = _raise_axes(lower, (0, 1), prime)
    66	    n1050 = composite_n1050(form, prime)
    67	    n4125 = composite_n4125(form, prime)
    68	    q = mod_einsum("abcdmn,abcdrl->mnrl", [n1050, _raise_axes(n1050, (0, 1, 2, 3), prime)], prime)
    69	    sym = np.zeros_like(q)
    70	    for perm in itertools.permutations(range(4)):
    71	        sym = (sym + q.transpose(perm)) % prime
    72	    sym = sym * inv(24, prime) % prime
    73	    q_mixed = _raise_axes(q, (2, 3), prime)
    74	    return [
    75	        matrix_trace_power(mixed, 4, prime),
    76	        int(mod_einsum("ad,be,cf,defabc->", [mixed, mixed, mixed, _raise_axes(n4125, (3, 4, 5), prime)], prime)),
    77	        int(mod_einsum("mn,mnrl,rl->", [upper, q, upper], prime)),
    78	        int(mod_einsum("mnrl,mnrl->", [sym, _raise_axes(q, (0, 1, 2, 3), prime)], prime)),
    79	        int((mod_einsum("am,bn,mnab->", [mixed, mixed, q_mixed], prime)
    80	             - mod_einsum("bm,an,mnab->", [mixed, mixed, q_mixed], prime)) * inv(2, prime) % prime),
    81	        int(mod_einsum("am,bn,mnpqrs,pqrsab->", [mixed, mixed, n1050, _raise_axes(n4125, range(6), prime)], prime)),
    82	    ]
