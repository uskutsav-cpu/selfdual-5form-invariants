    56	def test_product_and_functional_ranks_are_different():
    57	    # x^2 and y^2 are independent homogeneous polynomials on two variables.
    58	    # Their gradients add no functional directions after x and y.
    59	    polynomial = PolynomialSieve(2, 3, 32749)
    60	    assert polynomial.add("x^2", [1, 4, 9])
    61	    assert polynomial.add("y^2", [4, 9, 25])
    62	    functional = RankSieve(2, 32749)
    63	    assert functional.add([1, 0]) and functional.add([0, 1])
    64	    assert not functional.add([2, 0]) and not functional.add([0, 4])
    65	    assert polynomial.rank == functional.rank == 2
