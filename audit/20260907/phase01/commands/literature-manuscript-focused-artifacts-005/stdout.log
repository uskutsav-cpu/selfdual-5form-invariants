    78	def test_integral_coordinates_are_selfdual_and_have_no_denominators():
    79	    directions, indices = integral_directions()
    80	    assert set(np.unique(directions)) == {-1, 0, 1}
    81	    for prime in (32749, 32719):
    82	        assert np.array_equal(hodge_matrix(10, 5, True, prime) @ directions % prime, directions % prime)
    83	        _, basis, compact = context(prime, list(range(126)))
    84	        assert compact[indices].tolist() == list(range(126))
    85	        assert basis.ncols == 126
