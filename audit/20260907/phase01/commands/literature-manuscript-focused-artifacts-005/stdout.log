    25	def _contract_four(tensor, subscripts, prime):
    26	    """Explicit one-metric-per-edge contraction of four covariant tensors."""
    27	    seen, operands = set(), []
    28	    for term in subscripts.split(","):
    29	        raised = [i for i, index in enumerate(term) if index in seen]
    30	        seen.update(term)
    31	        operands.append(_raise_axes(tensor, raised, prime))
    32	    return int(mod_einsum(subscripts + "->", operands, prime))
    33	
    34	
    35	def evaluate_selected_basis(form, prime):
    36	    """A verified selection across the paper's two displayed lists.
    37	
    38	    T8_1,...,T8_5,H8_1 are used explicitly, rather than assuming either
    39	    displayed list supplies a primitive complement under a literal reading.
    40	    """
    41	    first = evaluate_basis(form, prime)
    42	    red = _antisymmetrize_axes(composite_n1050(form, prime), (3, 4, 5), prime)
    43	    hatted1 = -_contract_four(red, "abcdrs,abcduv,urefgh,sefvgh", prime) % prime
    44	    return first[:5] + [hatted1]
    45	
    46	
    47	def evaluate_alternative_basis(form, prime):
    48	    """Five hatted N1050 expressions plus the second invariant in (4.12)."""
    49	    n = composite_n1050(form, prime)
    50	    red = _antisymmetrize_axes(n, (3, 4, 5), prime)
    51	    words = ["abcdrs,abcduv,urefgh,sefvgh", "abcdrs,abcduv,refugh,segfhv",
    52	             "abcrst,abcuvw,rsefgu,tvfegw", "abcrst,abcuvw,uresfg,tvfweg",
    53	             "urabcd,sabvcd,suefgh,vefrgh"]
    54	    result = [_contract_four(red, word, prime) for word in words]
    55	    result[0] = -result[0] % prime
    56	    _, mixed = five_form_moment(form, prime)
    57	    n4125 = composite_n4125(form, prime)
    58	    result.append(int(mod_einsum("ad,be,cf,defabc->", [mixed, mixed, mixed,
    59	                      _raise_axes(n4125, (3, 4, 5), prime)], prime)))
    60	    return result
    61	
