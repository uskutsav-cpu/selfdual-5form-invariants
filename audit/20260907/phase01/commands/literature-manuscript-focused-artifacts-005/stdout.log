    34	def test_graph_interchange_preserves_order_and_old_formats(n):
    35	    graph = _regular_graph(n)
    36	    for encoding in (dumps(graph), graph_label(graph), graph_to_record(graph)):
    37	        assert np.array_equal(loads(encoding), graph)
    38	    assert loads(dumps(graph))[0, n - 1] == 1
