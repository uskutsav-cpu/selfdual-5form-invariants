     1	"""The six displayed tensor expressions (4.12)--(4.16) of arXiv:2509.14350v2.
     2	
     3	Normalized symmetrization is applied after the five-index antisymmetrization
     4	already present in N1050. We implement the displayed expressions literally;
     5	no additional trace subtraction is silently inserted. Lower-degree products
     6	must be included when comparing different primitive representatives.
     7	"""
     8	
     9	import itertools
    10	
    11	import numpy as np
    12	
    13	from .modp import inv, mod_einsum
    14	from .stress import (five_form_moment, matrix_trace_power, composite_n1050,
    15	                     composite_n4125, _raise_axes, _antisymmetrize_axes)
    16	
    17	SOURCE = "https://arxiv.org/html/2509.14350v2#S4.SS1.SSS3"
    18	BASIS = [{"id": f"T8_{i}", "equation": eq} for i, eq in
    19	         enumerate(["4.12", "4.12", "4.13", "4.14", "4.15", "4.16"], 1)]
    20	ALTERNATIVE_BASIS = [{"id": f"H8_{i}", "equation": eq} for i, eq in
    21	                     enumerate(["4.18", "4.20", "4.21", "4.22", "4.23", "4.12 (second)"], 1)]
    22	SELECTED_BASIS = BASIS[:5] + [ALTERNATIVE_BASIS[0]]
