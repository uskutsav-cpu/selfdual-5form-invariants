    68	def test_degree12_product_inventory_is_ten_monomials():
    69	    generators = {"I4_1": 4, "I6_1": 6, "I6_2": 6}
    70	    generators.update({f"I8_{k}": 8 for k in range(1, 7)})
    71	    generators.update({f"I10_{k}": 10 for k in range(1, 13)})
    72	    products = product_monomials(generators, 12)
    73	    assert len(products) == len(set(products)) == 10
    74	    assert ("I4_1",) * 3 in products
    75	    assert ("I6_1", "I6_2") in products
