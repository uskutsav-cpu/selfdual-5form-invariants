{'manuscript/prl/main.tex': ['\\begin{figure}[t]\n\\includegraphics[width=\\columnwidth]{figures/prl_spaces.pdf}\n\\caption{The degree-ten invariant space and its subspaces, with exact\ndimensions. Products of lower-degree invariants lie inside the reachable sector,\nso the \\dimQten-dimensional quotient is not generated by anything of lower\norder. Shading is redundant with the labels; the figure reads in grayscale.}\n\\label{fig:spaces}\n\\end{figure}', '\\begin{figure}[t]\n\\includegraphics[width=\\columnwidth]{figures/prl_crossvalidation.pdf}\n\\caption{The same quotient in three descriptions. Arrows are verified maps;\nnumbers are ranks established by two-way span containment on a common sample\nregistry, in exact arithmetic at several primes.}\n\\label{fig:cross}\n\\end{figure}'], 'manuscript/prd/main.tex': ['\\begin{figure*}[!tbp]\n\\centering\n\\includegraphics[width=0.86\\textwidth]{figures/fig01_degree_spectrum.pdf}\n\\caption{Degree-resolved tensor, spinor and union ranks. At every degree shown\nthe three agree, so neither formulation sees an invariant the other misses.}\n\\label{fig:degranks}\n\\end{figure*}', '\\begin{figure*}[!tbp]\n\\centering\n\\includegraphics[width=0.86\\textwidth]{figures/fig02_degree8_ablation.pdf}\n\\caption{Degree-eight family ablation. Removing the tensor words from the spinor\ncandidate family lowers the rank by one, so within this decomposition they are\nindispensable.}\n\\label{fig:ablation}\n\\end{figure*}', "\\begin{figure*}[!tbp]\n\\centering\n\\includegraphics[width=0.86\\textwidth]{figures/fig04_pivot_composition.pdf}\n\\caption{The $\\minorSize$ pivot rows of the certified minor, read from the\ncertificate's own row list. Left, by the field degree of the candidate; right,\nby the family it belongs to. Neither split is uniform, and neither is\nconcentrated in a single bucket.}\n\\label{fig:pivots}\n\\end{figure*}", '\\begin{figure*}[!tbp]\n\\centering\n\\includegraphics[width=0.86\\textwidth]{figures/fig03_rank_matrix.pdf}\n\\caption{The prime/sample rank matrix. Every cell agrees on rank and on pivot\nstructure.}\n\\label{fig:matrix}\n\\end{figure*}', '\\begin{figure*}[!tbp]\n\\centering\n\\includegraphics[width=0.86\\textwidth]{figures/fig05_rational_heights.pdf}\n\\caption{Size of the largest numerator and denominator appearing in a basis\nvector of the flow-reachable space, by degree, in bits. The dashed line is the\nrepresentable range of a single prime near $2^{15}$. Degree ten is the first\nplace the exact coefficients leave that range, which is why that row is lifted\nby the Chinese remainder theorem and rational reconstruction rather than read\noff one modular solve.}\n\\label{fig:heights}\n\\end{figure*}']}
