121: 
122: def classify(name: str):
123:     for pattern, artifact, cmd, strength, note in SOURCES:
124:         if re.search(pattern, name):
125:             return artifact, cmd, strength, note
126:     return None, None, "UNCLASSIFIED", "no source mapping"
127: 
128: 
129: def main() -> int:
130:     if not GEN.exists():
131:         print("generated/numbers.tex missing; run make_numbers.py")
132:         return 1
133:     macros = re.findall(r"\\newcommand\{\\(\w+)\}\{([^}]*)\}", GEN.read_text())
134: 
135:     rows, unclassified = [], []
136:     for name, value in macros:
137:         artifact, cmd, strength, note = classify(name)
138:         if strength == "UNCLASSIFIED":
139:             unclassified.append(name)
140:         rows.append({"macro": name, "value": value, "artifact": artifact,
141:                      "regenerate": cmd, "strength": strength, "note": note})
142: 
143:     from collections import Counter
144:     counts = Counter(r["strength"] for r in rows)
145: 
146:     OUT_JSON.parent.mkdir(parents=True, exist_ok=True)
147:     OUT_JSON.write_text(json.dumps({
148:         "schema": 1,
149:         "generated_by": "scripts/emit_claim_certificate_matrix.py",
150:         "n_macros": len(rows),
151:         "by_strength": dict(counts),
152:         "unclassified": unclassified,
153:         "entries": rows,
154:     }, indent=1) + "\n")
155: 
