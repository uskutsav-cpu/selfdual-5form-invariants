151: \begin{minipage}{0.94\columnwidth}
152: \centering\vspace{3pt}
153: {\bfseries\footnotesize DRAFT FOR MENTOR REVIEW --- NOT FOR SUBMISSION}\\[2pt]
154: {\bfseries\footnotesize AUTHORSHIP AND AFFILIATIONS NOT YET FINALIZED}\\[3pt]
155: \scriptsize
156: The author list, author order, corresponding author, affiliations and ORCIDs
157: are unresolved. No licence has been selected, no DOI has been minted, and
158: nothing here has been submitted to arXiv or to a journal. Items marked in
159: \textcolor{red}{\textbf{red}} throughout are pending human decisions.
160: \vspace{3pt}
161: \end{minipage}}
162: \end{center}
163: \vspace{4pt}
164: """
165: 
166: 
167: def convert_shared(text: str) -> str:
168:     """Two-column adjustments applied to appendices and generated tables alike.
169: 
170:     Verbatim is the awkward case: a shell command cannot be hyphenated or
171:     reflowed, so a clone URL that fits a 6-inch measure simply will not fit a
172:     3.4-inch column. Setting it smaller is the only honest option short of
173:     editing the command, and the command has to stay copy-pasteable.
174:     """
175:     text = text.replace(r"\begin{verbatim}",
176:                         "\\begingroup\\scriptsize\n\\begin{verbatim}")
177:     text = text.replace(r"\end{verbatim}",
178:                         "\\end{verbatim}\n\\endgroup")
179:     # Generated tables are sized for a single-column page. Reducing the type
180:     # size fixes most of them; the widest still overrun. An unconditional
181:     # \resizebox is the wrong tool -- it scales every table to exactly the text
182:     # width, which blows a three-row table up into a billboard. The conditional
183:     # form below shrinks a table only when it is genuinely too wide and leaves
184:     # the rest at their natural size.
185:     text = text.replace(
186:         r"\begin{tabular}",
187:         "\\footnotesize\n"
188:         "\\resizebox{\\ifdim\\width>\\linewidth \\linewidth\\else\\width\\fi}{!}{%\n"
189:         "\\begin{tabular}")
190:     text = text.replace(r"\end{tabular}", "\\end{tabular}}")
191:     # A p-column measured against \textwidth does not adapt to the float it
192:     # sits in: inside a single-column table it is far too wide, and the
193:     # conditional \resizebox cannot rescue it because the natural width is
194:     # already set. \linewidth is the right unit -- full width inside table*,
195:     # column width inside table -- so the same spec works in both.
196:     text = text.replace(r"\textwidth}", r"\linewidth}")
197:     # The tables declare their own float, so the single- to two-column
198:     # promotion has to happen here and not only in main.tex. Missing this left
199:     # every generated table as a single-column float and produced one 223pt
200:     # overrun that looked, from the log, like a runaway equation.
201:     # Promote to a full-width float ONLY when the table is actually wide. The
202:     # first version promoted every table, which put eighteen double-column
203:     # floats into a twenty-six page document; the page builder then ran out of
204:     # legal placements and LaTeX aborted with "Output loop---100 consecutive
205:     # dead cycles". A narrow table belongs in a column.
206:     ncols = 0
207:     m = re.search(r"\\begin\{tabular\}\{([^}]*)\}", text)
208:     if m:
209:         ncols = sum(1 for c in m.group(1) if c in "lcrp")
210:     # A p-column sized against \textwidth is wide however few columns there
211:     # are: tab13 has a single p{0.55\textwidth} cell and overran by 223pt while
212:     # the column count said "narrow".
213:     wide_spec = "textwidth" in (m.group(1) if m else "")
214:     if ncols >= 5 or wide_spec:
215:         text = re.sub(r"\\begin\{table\}(\[[^\]]*\])?",
216:                       r"\\begin{table*}[!tbp]", text)
217:         text = text.replace(r"\end{table}", r"\end{table*}")
218:     else:
219:         text = re.sub(r"\\begin\{table\}(\[[^\]]*\])?",
220:                       r"\\begin{table}[!tbp]", text)
221: 
222:     # Appendix displays are reference material and several are genuinely wider
223:     # than a column. Promoting *all* of them was tried and is wrong: widetext
224:     # interrupts column balancing, and a page of short widened displays
225:     # overflows vertically instead of horizontally -- the same defect moved to
226:     # the other axis. Only displays with a long source line are promoted, which
227:     # is a crude proxy for typeset width but errs on the side of leaving things
228:     # in the column where they belong.
229:     def widen_if_wide(m: re.Match) -> str:
230:         block = m.group(1)
231:         longest = max((len(ln) for ln in block.splitlines()), default=0)
232:         # Source line length alone is a poor proxy and produced a false
233:         # negative: a list of ten trace monomials, one short line each, sets as
234:         # a single very wide row. Horizontal separators are the better signal,
235:         # since each one is an item continuing on the same typeset line.
236:         separators = block.count(r"\;") + block.count(r"\quad") \
237:                    + block.count(r"\qquad") + block.count("&")
238:         if longest <= 78 and separators < 4:
239:             return block
240:         return "\\begin{widetext}\n" + block + "\n\\end{widetext}"
241: 
242:     text = re.sub(r"(\\begin\{equation\}.*?\\end\{equation\})",
243:                   widen_if_wide, text, flags=re.S)
244:     return text
245: 
246: 
247: def convert(src: str) -> str:
248:     # --- abstract: macro form -> environment form -------------------------
249:     m = re.search(r"\\abstract\{%?\n(.*?)\n\}\n\n\\begin\{document\}",
250:                   src, re.S)
251:     if not m:
252:         raise SystemExit("could not locate the JHEP \\abstract{...} block")
253:     abstract = m.group(1).rstrip().rstrip("%").rstrip()
254: 
255:     # --- body: everything from the banner to \end{document} ---------------
256:     start = src.index(r"% ---------------------------------------------------------------- banner")
257:     body = src[start:]
258:     # Drop the JHEP banner block; the REVTeX one is inserted separately.
259:     body = re.sub(
260:         r"% -+ banner\n\\begin\{center\}.*?\\end\{center\}\n\\vspace\{6pt\}\n",
261:         "", body, count=1, flags=re.S)
262: 
263:     # --- floats: PRD is two-column, so every float goes full width --------
264:     # A 0.95-textwidth figure is wider than a PRD column. Promoting to the
265:     # starred form and rescaling is the honest fix; shrinking the figures to
266:     # column width would make the axis labels unreadable.
267:     body = body.replace(r"\begin{figure}[htbp]", r"\begin{figure*}[!tbp]")
268:     body = body.replace(r"\end{figure}", r"\end{figure*}")
269:     body = re.sub(r"\\includegraphics\[width=[0-9.]+\\textwidth\]",
270:                   r"\\includegraphics[width=0.86\\textwidth]", body)
271: 
272:     # Tables are generated with \begin{table}; the wide ones need table*.
273:     body = body.replace(r"\begin{table}[", r"\begin{table*}[")
274:     body = body.replace(r"\end{table}", r"\end{table*}")
275: 
276:     # --- wide displays ----------------------------------------------------
277:     # A few equations are genuinely wider than a PRD column and cannot be
278:     # broken without obscuring what they say -- a multi-case grading rule, an
279:     # aligned block of certified identities. REVTeX's widetext is the intended
280:     # mechanism: the display spans both columns and the text flows around it.

