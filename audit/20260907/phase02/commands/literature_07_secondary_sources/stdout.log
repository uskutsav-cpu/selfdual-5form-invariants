1: #!/usr/bin/env python3
2: """Emit the machine-readable closure / minimality certificate.
3: 
4: Consolidates the reachability (closure) and minimality results into one
5: artifact with provenance, so they can be cited without re-running anything.
6: """
7: 
8: import json
9: import sys
10: from pathlib import Path
11: 
12: sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
13: sys.path.insert(0, str(Path(__file__).resolve().parent))
14: 
15: from stress_flow_closure import closure  # noqa: E402
16: 
17: ROOT = Path(__file__).resolve().parents[1]
18: CERT = ROOT / "results" / "stress_flow" / "certificates"
19: OUT = ROOT / "results" / "stress_flow" / "closure_and_minimality.json"
20: PRIMES = (32749, 32719, 32717, 32693)
21: DEGREES = (4, 6, 8, 10, 12)
22: FULL = {4: 1, 6: 2, 8: 7, 10: 14, 12: 72}
23: STATIC = {4: 1, 6: 1, 8: 2, 10: 2, 12: 4}
24: REQUIRED8 = ("I8_3", "I8_4", "I8_5", "I8_6")
25: INERT8 = ("I8_1", "I8_2", "I4_1^2")
26: 
27: 
28: def certificates():
29:     out = []
30:     for prime in PRIMES:
31:         path = CERT / f"interacting_degree12_{prime}.json"
32:         if path.exists():
33:             with path.open() as stream:
34:                 out.append((prime, json.load(stream)))
35:     return out
36: 
37: 
38: def agree(seed, certs):
39:     """Closure dims, asserting every prime agrees."""
40:     seen = None
41:     for prime, cert in certs:
42:         dims, _ = closure(cert, seed, prime)
43:         if seen is None:
44:             seen = dims
45:         elif dims != seen:
46:             raise AssertionError(f"prime {prime} disagrees: {dims} != {seen}")
47:     return {str(k): v for k, v in seen.items()}
48: 
49: 
50: def main():
51:     certs = certificates()
52:     if len(certs) < 3:
53:         raise SystemExit("need at least three interacting certificates")
54: 
55:     seeds = {
56:         "free": {4: ["I4_1"]},
57:         "free_plus_K6": {4: ["I4_1"], 6: ["I6_2"]},
58:         "free_plus_J6": {4: ["I4_1"], 6: ["I6_1"]},
59:         "free_plus_K6_and_degree8_complement": {
60:             4: ["I4_1"], 6: ["I6_2"], 8: list(REQUIRED8)},
61:         "free_plus_degree8_complement_only": {
62:             4: ["I4_1"], 8: list(REQUIRED8)},
63:     }
64:     closures = {name: agree(seed, certs) for name, seed in seeds.items()}
65: 
66:     # minimality: drop one required degree-8 direction at a time
67:     removal = {}
68:     for omitted in REQUIRED8:
69:         kept = [d for d in REQUIRED8 if d != omitted]
70:         removal[f"without_{omitted}"] = agree(
71:             {4: ["I4_1"], 6: ["I6_2"], 8: kept}, certs)
72:     removal["without_K6"] = closures[
73:         "free_plus_degree8_complement_only"]
74: 
75:     inert = {}
