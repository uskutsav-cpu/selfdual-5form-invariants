1: #!/usr/bin/env python3
2: """Generate the PRD (REVTeX 4.2) manuscript from the JHEP source.
3: 
4: There is one copy of the prose, the mathematics and the appendices, and it lives
5: in manuscript/jhep/. This script rewrites that source into the two-column APS
6: form rather than forking it, because two hand-maintained copies of a 45-page
7: argument diverge silently and the whole point of the surrounding machinery is
8: that nothing important is maintained twice.
9: 
10: What actually differs between the two journals is small and mechanical:
11: 
12:   * the class and preamble (revtex4-2 with aps,prd,reprint);
13:   * the abstract, which REVTeX takes as an environment rather than a macro;
14:   * float widths, since a 0.95-textwidth figure does not fit a PRD column --
15:     every float is promoted to the full-width starred form and re-scaled;
16:   * the bibliography style;
17:   * theorem environments, which REVTeX does not provide.
18: 
19: Everything else -- every section, equation, theorem, table and appendix -- is
20: carried across verbatim.
21: 
22:     python3 manuscript/prd/build_prd.py
23: """
24: 
25: from __future__ import annotations
26: 
27: import re
28: import shutil
29: import sys
30: from pathlib import Path
31: 
32: ROOT = Path(__file__).resolve().parents[2]
33: JHEP = ROOT / "manuscript" / "jhep"
34: PRD = ROOT / "manuscript" / "prd"
35: 
36: # Displays that cannot be narrowed without losing their point, and so are set
37: # across both columns. Keep this list short: an equation that fits belongs in a
38: # column, and the reflex to widen everything produces a two-column paper that
39: # reads like a one-column paper with gaps in it.
40: WIDE = [
41:     "eq:bridgerank",       # three certified identities, aligned in two columns
42:     "eq:leadingdegree",    # a cases block beside a summation rule
43:     "eq:closureoperator",  # set-builder with a degree condition
44:     "eq:rawvsactivated",   # an equality and a strict inclusion, side by side
45:     "eq:equivariance",     # carries the character and its value
46:     "eq:jacobian",         # matrix with both index ranges spelled out
47:     "eq:generators",       # ten trace monomials in a two-row block
48: ]
49: 
50: # eq:sdprojector, eq:bridge and eq:bpidentity were on this list until they were
51: # rewritten across two lines in the shared source. Narrowing the display is
52: # always better than widening the page: it costs nothing in the single-column
53: # version and removes a column break from the two-column one.
