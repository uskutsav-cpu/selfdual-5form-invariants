1: #!/usr/bin/env python3
2: """Map every generated manuscript number to the artifact that produced it.
3: 
4: Each entry records the macro, its current value, the artifact it is read from,
5: the command that regenerates it, and the strength of the underlying evidence.
6: 
7: Strength is the point. The manuscript mixes five kinds of statement and a reader
8: cannot tell them apart from the typeset number alone:
9: 
10:     analytic          a theorem or a literature result, no computation
11:     exact-char0       exact over Q, with a certificate
12:     exact-modular     exact over F_p; a bound in characteristic zero unless the
13:                       spanning-set argument applies
14:     multi-prime       agreement across primes; probabilistic, not a proof
15:     numerical         floating point, with a tolerance
16:     limitation        a stated scope restriction rather than a result
17: 
18:     python scripts/emit_claim_certificate_matrix.py
19: """
20: 
21: from __future__ import annotations
22: 
23: import json
24: import re
25: from pathlib import Path
26: 
27: ROOT = Path(__file__).resolve().parents[1]
28: GEN = ROOT / "manuscript" / "generated" / "numbers.tex"
29: OUT_MD = ROOT / "audit" / "FINAL_CLAIM_CERTIFICATE_MATRIX.md"
30: OUT_JSON = ROOT / "audit" / "FINAL_CLAIM_CERTIFICATE_MATRIX.json"
31: 
32: #: macro prefix/name -> (artifact, regeneration command, strength, note)
