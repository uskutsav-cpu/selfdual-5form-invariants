1: #!/usr/bin/env python3
2: """Checkpointed degree runner with separate polynomial and functional sieves.
3: 
4: By default, revalidate the discovered graph inventory at the chosen degree.
5: For new searches, --candidates accepts edge-list JSONL records, optionally
6: wrapped as {"id": ..., "graph": ...}. Nothing is exhaustively enumerated by
7: default. Exact nauty generation remains in the existing degree pipelines.
8: """
9: 
10: import argparse
11: from concurrent.futures import ProcessPoolExecutor
12: import hashlib
13: import json
14: import os
15: from pathlib import Path
16: import sys
17: 
18: for name in ("OPENBLAS_NUM_THREADS", "OMP_NUM_THREADS", "VECLIB_MAXIMUM_THREADS"):
19:     os.environ.setdefault(name, "1")
20: 
21: ROOT = Path(__file__).resolve().parents[1]
22: sys.path.insert(0, str(ROOT / "src"))
23: 
24: import numpy as np
25: from sdinv.catalog import atomic_write_json
26: from sdinv.certificate import digest, evaluate_item, require_prime
27: from sdinv.checkpoint import load_checkpoint, write_checkpoint
28: from sdinv.graphs import graph_from_label, validate_graph
29: from sdinv.modp import RankSieve
30: from sdinv.primitive import HILBERT_DIMENSIONS, HILBERT_FACTOR_EXPONENTS, PolynomialSieve, product_monomials
31: from sdinv.serialize import loads, to_record
32: 
33: 
34: def inventory():
35:     result = []
36:     for degree in (8, 10, 12):
37:         for item in json.loads((ROOT / f"results/10d_order{degree}.json").read_text())["generators"]:
38:             result.append({"id": item["id"], "degree": item["order"],
39:                            "graph": to_record(graph_from_label(item["graph"]))})
40:     return result
41: 
42: 
43: def candidate_stream(path, known, degree):
44:     if path is None:
45:         yield from (item for item in known if item["degree"] == degree)
46:         return
47:     with Path(path).open() as stream:
48:         for line in stream:
49:             if not line.strip():
50:                 continue
51:             record = json.loads(line)
52:             matrix = loads(record.get("graph", record))
53:             validate_graph(matrix, 5, 4)
54:             if len(matrix) != degree:
55:                 raise ValueError("candidate degree mismatch")
56:             graph = to_record(matrix)
57:             yield {"id": record.get("id", digest(graph)), "degree": degree, "graph": graph}
58: 
59: 
60: def _evaluate(job):
61:     item, prime, points = job
62:     return {"item": item, "samples": [evaluate_item(item, prime, point) for point in points]}
63: 
64: 
65: def _product_gradient(factors, cache, sample, prime):
66:     scalar, row = 1, np.zeros(126, dtype=np.int64)
67:     for factor in factors:
68:         value = cache[factor][sample]["value"]
69:         derivative = np.array(cache[factor][sample]["jacobian_row"])
70:         row = (row * value + scalar * derivative) % prime
71:         scalar = scalar * value % prime
72:     return row
73: 
74: 
75: def run(degree, prime, seeds, candidates=None, checkpoint=None, workers=1, max_candidates=None):
76:     require_prime(prime)
77:     if degree <= 0 or degree % 2 or degree * 5 // 2 > 52:
78:         raise ValueError("positive even degree with at most 52 contracted pairs required")
79:     if len(seeds) < 2 or len(set(seeds)) != len(seeds) or workers < 1:
80:         raise ValueError("at least two distinct sample seeds and positive workers required")
81:     known = inventory()
82:     lower = [x for x in known if x["degree"] < degree]
83:     # Above degree 14, the committed lower-degree inventory is no longer
84:     # polynomially complete. Rank evidence is still useful, but do not call
85:     # a candidate primitive relative to uncomputed lower generators.
86:     lower_polynomial_inventory_complete = degree <= 14
87:     if degree > 12 and candidates is None:
88:         raise ValueError("supply --candidates JSONL for degrees above the discovered inventory")
89:     points = [np.random.default_rng(s).integers(0, prime, 126).tolist() for s in seeds]
90:     sources = [ROOT / "src/sdinv" / f"{name}.py" for name in ("certificate", "contract", "forms", "modp", "primitive", "serialize", "graphs")]
91:     sources.append(Path(__file__))
92:     identity = {"degree": degree, "prime": prime, "seeds": seeds, "points": points,
93:                 "inventory_sha256": digest(known), "engine_sha256": digest([hashlib.sha256(p.read_bytes()).hexdigest() for p in sources]),
94:                 "candidates_sha256": hashlib.sha256(Path(candidates).read_bytes()).hexdigest() if candidates else None}
95:     state = load_checkpoint(checkpoint, identity) if checkpoint and Path(checkpoint).exists() else {"lower": [], "accepted": [], "cursor": 0}
96:     if [r["item"] for r in state["lower"]] != lower[:len(state["lower"])]:
97:         raise ValueError("checkpoint lower inventory mismatch")
98: 
99:     def save():
100:         if checkpoint:
101:             write_checkpoint(checkpoint, identity, state)
102: 
103:     # Lower computations are also resumable; never lose expensive warmup rows.
104:     for item in lower[len(state["lower"]):]:
105:         state["lower"].append(_evaluate((item, prime, points)))
106:         save()
107:     functional = RankSieve(126, prime)
108:     cache = {r["item"]["id"]: r["samples"] for r in state["lower"]}
109:     for r in state["lower"]:
110:         functional.add(r["samples"][0]["jacobian_row"])
111:     polynomial = PolynomialSieve(degree, 126 * len(points), prime, "stacked_gradients")
112:     products = product_monomials({x["id"]: x["degree"] for x in lower}, degree)
113:     for factors in products:
114:         row = np.concatenate([_product_gradient(factors, cache, k, prime) for k in range(len(points))])
115:         polynomial.add("*".join(factors), row, product=True)
116:     for r in state["accepted"]:
117:         polynomial.add(r["item"]["id"], np.concatenate([s["jacobian_row"] for s in r["samples"]]))
118:         functional.add(r["samples"][0]["jacobian_row"])
119:     stream = iter(candidate_stream(candidates, known, degree))
120:     for _ in range(state["cursor"]):
121:         next(stream)
122:     pool = ProcessPoolExecutor(max_workers=workers) if workers > 1 else None
123:     try:
124:         while not polynomial.complete and (max_candidates is None or state["cursor"] < max_candidates):
125:             batch = []
126:             for _ in range(workers):
127:                 if max_candidates is not None and state["cursor"] + len(batch) >= max_candidates:
128:                     break
129:                 item = next(stream, None)
130:                 if item is None:
131:                     break
132:                 batch.append((item, prime, points))
133:             if not batch:
134:                 break
135:             for evaluated in (pool.map(_evaluate, batch) if pool else map(_evaluate, batch)):
136:                 state["cursor"] += 1
137:                 item, samples = evaluated["item"], evaluated["samples"]
138:                 primitive = polynomial.add(item["id"], np.concatenate([s["jacobian_row"] for s in samples]))
139:                 functional_increment = functional.add(samples[0]["jacobian_row"])
140:                 if functional_increment and not primitive:
141:                     raise ValueError("functional pivot without a polynomial pivot")
142:                 if primitive:
143:                     evaluated.update({"functional_increment": functional_increment, "polynomial_rank": polynomial.rank,
144:                                       "functional_rank": functional.rank, "functional_pivots": list(functional.pivots),
145:                                       "polynomial_pivots": list(polynomial.sieve.pivots)})
146:                     state["accepted"].append(evaluated)
147:                     print(f"degree {degree} p={prime}: polynomial {polynomial.rank}, functional {functional.rank}", flush=True)
148:                 save()
149:                 if polynomial.complete:
150:                     break
151:     finally:
152:         if pool:
153:             pool.shutdown(wait=True, cancel_futures=True)
154:     return {"schema": 1, "degree": degree, "prime": prime, "seeds": seeds, "coordinates": points,
155:             "polynomial_method": "gradients stacked across independently sampled points",
156:             "polynomial_rank": polynomial.rank, "product_rank": len(polynomial.product_ids),
157:             "primitive_directions_found": len(polynomial.primitive_ids), "functional_rank": functional.rank,
158:             "primitive_count_certified_relative_to_all_lower_degrees": lower_polynomial_inventory_complete,
159:             "hilbert_dimension": HILBERT_DIMENSIONS.get(degree),
160:             "hilbert_factor_exponent": HILBERT_FACTOR_EXPONENTS.get(degree),
161:             "polynomial_complete": polynomial.complete, "candidates_evaluated": state["cursor"],
162:             "accepted": state["accepted"], "identity": identity,
163:             "scope": "Rank lower bounds from fixed exact samples. Polynomial completeness uses the supplied Hilbert upper bound; a rejected row alone is not a symbolic relation. Above degree 14, candidate pivots are only relative to the supplied, incomplete lower inventory."}
164: 
165: 
166: def main(argv=None):
167:     parser = argparse.ArgumentParser(description=__doc__)
168:     parser.add_argument("--degree", type=int, required=True)
169:     parser.add_argument("--primes", type=int, nargs="+", default=[32749, 32719])
170:     parser.add_argument("--seeds", type=int, nargs="+", default=[20260907, 20260908])
171:     parser.add_argument("--candidates", type=Path)
172:     parser.add_argument("--checkpoint-dir", type=Path, default=ROOT / "work/degrees")
173:     parser.add_argument("--workers", type=int, default=1)
174:     parser.add_argument("--max-candidates", type=int)
175:     parser.add_argument("--out", type=Path)
176:     args = parser.parse_args(argv)
177:     results = []
178:     for prime in args.primes:
179:         results.append(run(args.degree, prime, args.seeds, args.candidates,
180:                            args.checkpoint_dir / f"degree{args.degree}_p{prime}.json",
181:                            args.workers, args.max_candidates))
182:     selection = [[r["item"]["graph"] for r in result["accepted"]] for result in results]
183:     same_basis = all(basis == selection[0] for basis in selection)
184:     payload = {"runs": results, "same_selected_basis": same_basis,
185:                "complete": same_basis and all(r["polynomial_complete"] for r in results)}
186:     atomic_write_json(args.out or ROOT / f"results/degree{args.degree}_verification.json", payload)
187:     if not payload["complete"]:
188:         print("INCOMPLETE: search evidence saved; no degree-completeness claim")
189:         return 2
190:     print("PASS: same selected basis, independently checked polynomial and functional ranks")
191:     return 0
192: 
193: 
194: if __name__ == "__main__":
195:     raise SystemExit(main())

