FILE scripts/validate_rank81_lorentz.py
1: #!/usr/bin/env python3
2: """Check every fixed graph under an exact spatial rotation and a genuine boost."""
3: 
4: import json
5: from pathlib import Path
6: import sys
7: 
8: ROOT = Path(__file__).resolve().parents[1]
9: sys.path.insert(0, str(ROOT / "src"))
10: 
11: import numpy as np
12: from sdinv.catalog import atomic_write_json
13: from sdinv.certificate import context, digest, validate_basis
14: from sdinv.contract import planned_value
15: from sdinv.serialize import from_record
16: from sdinv.published_degree8_invariants import evaluate_selected_basis
17: 
18: 
19: def transform(form, matrix, prime):
20:     for axis in range(5):
21:         # A sum of ten reduced products fits exactly in int64 for our primes.
22:         form = np.moveaxis(np.tensordot(matrix, form, axes=(1, axis)), 0, axis) % prime
23:     return form
24: 
25: 
26: def main():
27:     manifest = json.loads((ROOT / "results/rank81_basis.json").read_text())
28:     certificate = json.loads((ROOT / "results/rank81_certificate.json").read_text())
29:     if not certificate["complete"]:
30:         raise ValueError("finish the rank certificate first")
31:     items = validate_basis(manifest)
32:     witness = certificate["witnesses"][0]
33:     prime = witness["prime"]
34:     form, _, _ = context(prime, witness["coordinates"])
35:     eta = np.diag([-1] + [1] * 9)
36:     rotations = {}
37:     rotation = np.eye(10, dtype=np.int64)
38:     t = 5
39:     c, s = (1 - t*t) * pow(1 + t*t, -1, prime) % prime, 2*t * pow(1 + t*t, -1, prime) % prime
40:     rotation[2, 2], rotation[3, 3], rotation[2, 3], rotation[3, 2] = c, c, s, -s % prime
41:     rotations["spatial_rotation"] = rotation
42:     boost = np.eye(10, dtype=np.int64)
43:     t = 7
44:     c, s = (1 + t*t) * pow(1 - t*t, -1, prime) % prime, 2*t * pow(1 - t*t, -1, prime) % prime
45:     boost[0, 0], boost[1, 1], boost[0, 1], boost[1, 0] = c, c, s, s
46:     rotations["lorentz_boost"] = boost
47:     tensor_values = evaluate_selected_basis(form, prime)
48:     result = {"schema": 1, "prime": prime, "seed": witness["seed"],
49:               "basis_sha256": digest(manifest), "checks": {}, "passed": False}
50:     for name, matrix in rotations.items():
51:         if not np.array_equal(matrix.T @ eta @ matrix % prime, eta % prime):
52:             raise ValueError("test matrix is not Lorentz")
53:         transformed = transform(form, matrix, prime)
54:         matched = []
55:         for item, expected in zip(items, witness["values"]):
56:             scalar = planned_value(from_record(item["graph"]), transformed, 10, 5, True, prime,
57:                                    max_memory_bytes=2 * 1024**3)
58:             if scalar != expected:
59:                 raise ValueError(f"{name} fails for {item['id']}")
60:             matched.append(item["id"])
61:         if evaluate_selected_basis(transformed, prime) != tensor_values:
62:             raise ValueError(f"{name} fails for selected literature basis")
63:         result["checks"][name] = {"matrix": matrix.tolist(), "matched_invariants": matched,
64:                                    "literature_order8_basis_matched": True}
65:         print(f"PASS: {name}, all {len(matched)} graphs and six literature tensors", flush=True)
66:     result["passed"] = True
67:     atomic_write_json(ROOT / "results/rank81_lorentz.json", result)
68: 
69: 
70: if __name__ == "__main__":
71:     main()

FILE scripts/graph_to_latex.py
1: #!/usr/bin/env python3
2: """Export the same fixed 81 ordered graph formulas used by the certificate."""
3: 
4: import argparse
5: import json
6: from pathlib import Path
7: import sys
8: 
9: ROOT = Path(__file__).resolve().parents[1]
10: sys.path.insert(0, str(ROOT / "src"))
11: 
12: from sdinv.catalog import atomic_write_json
13: from sdinv.certificate import digest, validate_basis
14: from sdinv.contract import contraction_plan_profile
15: from sdinv.graphs import graph_from_label
16: from sdinv.latex import graph_to_latex, factor_lines
17: from sdinv.serialize import to_record
18: 
19: 
20: def export_basis():
21:     items, sources = [], {}
22:     for degree in (8, 10, 12):
23:         path = ROOT / "results" / f"10d_order{degree}.json"
24:         data = json.loads(path.read_text())
25:         sources[str(path.relative_to(ROOT))] = digest(data)
26:         for item in data["generators"]:
27:             if degree == 12 and not item["functional_increment"]:
28:                 continue
29:             matrix = graph_from_label(item["graph"])
30:             record = to_record(matrix)
31:             items.append({"id": item["id"], "degree": item["order"],
32:                           "graph": record, "label": item["graph"],
33:                           "formula_sha256": digest(record),
34:                           "adjacency_matrix": matrix.tolist(),
35:                           "einstein_formula": graph_to_latex(matrix),
36:                           "contraction_cost": contraction_plan_profile(matrix, 10, 5)})
37:     manifest = {"schema": 1, "invariants": items, "sources": sources,
38:                 "metric": [-1] + [1] * 9,
39:                 "formula_convention": "Lexicographic edges and slots; incoming indices raised, outgoing indices lowered; one metric per edge.",
40:                 "scope": "81 generically algebraically independent invariants; local generic coordinates, not global orbit separation or the full invariant ring."}
41:     validate_basis(manifest)
42:     return manifest
43: 
44: 
45: def main():
46:     parser = argparse.ArgumentParser(description=__doc__)
47:     parser.add_argument("--out", default=str(ROOT / "results/rank81_basis.json"))
48:     parser.add_argument("--latex-out", default=str(ROOT / "paper/tables/rank81_formulas.tex"))
49:     parser.add_argument("--certificate", type=Path, default=ROOT / "results/rank81_certificate.json")
50:     parser.add_argument("--cells-out", type=Path, default=ROOT / "paper/tables/certificate_cells.tex")
51:     args = parser.parse_args()
52:     manifest = export_basis()
53:     atomic_write_json(args.out, manifest)
54:     lines = ["% Generated by scripts/graph_to_latex.py; do not edit."]
55:     for item in manifest["invariants"]:
56:         matrix = graph_from_label(item["label"])
57:         lines += [rf"\paragraph{{\texttt{{{item['id'].replace('_', r'\_')}}}}}",
58:                   r"\begin{equation*}\begin{aligned}",
59:                   "&" + factor_lines(matrix), r"\end{aligned}\end{equation*}"]
60:     path = Path(args.latex_out)
61:     path.parent.mkdir(parents=True, exist_ok=True)
62:     path.write_text("\n".join(lines) + "\n")
63:     if args.certificate.exists():
64:         certificate = json.loads(args.certificate.read_text())
65:         if certificate.get("complete") and certificate["basis_sha256"] == digest(manifest):
66:             cells = [r"\begin{center}\begin{tabular}{rrrr}",
67:                      r"\toprule Prime & Seed & Rank & $\det J_*\bmod p$\\\midrule"]
68:             for witness in certificate["witnesses"]:
69:                 cells.append(f"{witness['prime']} & {witness['seed']} & {witness['rank']} & {witness['determinant_mod_p']}" + r"\\")
70:             cells.append(r"\bottomrule\end{tabular}\end{center}")
71:             args.cells_out.parent.mkdir(parents=True, exist_ok=True)
72:             args.cells_out.write_text("\n".join(cells) + "\n")
73:     print(f"Exported {len(manifest['invariants'])} formulas; basis SHA256 {digest(manifest)}")
74: 
75: 
76: if __name__ == "__main__":
77:     main()

FILE scripts/search_rank81.py
1: #!/usr/bin/env python3
2: """Rebuild a graph-only rank-81 witness from the existing discovered basis.
3: 
4: Discovery is already complete: degree10_pipeline.py and degree12_pipeline.py
5: retain their resumable catalog searches. This final stage evaluates exactly
6: the same 81 graphs in each field. Checkpoints retain every accepted raw row.
7: """
8: 
9: import argparse
10: from concurrent.futures import ProcessPoolExecutor
11: import json
12: import os
13: from pathlib import Path
14: import sys
15: 
16: for name in ("OPENBLAS_NUM_THREADS", "OMP_NUM_THREADS", "VECLIB_MAXIMUM_THREADS"):
17:     os.environ.setdefault(name, "1")
18: 
19: ROOT = Path(__file__).resolve().parents[1]
20: sys.path.insert(0, str(ROOT / "src"))
21: 
22: import numpy as np
23: from sdinv.catalog import atomic_write_json
24: from sdinv.certificate import (digest, evaluate_item, integral_directions,
25:                                make_witness, require_prime, validate_basis, verify_witness)
26: from sdinv.checkpoint import load_checkpoint, write_checkpoint
27: from sdinv.modp import RankSieve
28: 
29: 
30: def _job(args):
31:     return evaluate_item(*args)
32: 
33: 
34: def evaluate_cell(manifest, prime, seed, checkpoint_dir, workers):
35:     require_prime(prime)
36:     coordinates = np.random.default_rng(seed).integers(0, prime, 126).tolist()
37:     engine = {str(path.relative_to(ROOT)): path.read_bytes().hex() for path in
38:               [ROOT / "src/sdinv" / f"{name}.py" for name in
39:                ("certificate", "contract", "forms", "modp", "serialize", "graphs")]}
40:     identity = {"schema": 1, "basis_sha256": digest(manifest), "prime": prime,
41:                 "seed": seed, "coordinates": coordinates, "engine_sha256": digest(engine)}
42:     checkpoint = checkpoint_dir / f"p{prime}_s{seed}.json"
43:     state = load_checkpoint(checkpoint, identity) if checkpoint.exists() else {"evaluated": [], "pivots": [], "rank": 0}
44:     items = validate_basis(manifest)
45:     evaluated = state["evaluated"]
46:     if [r["id"] for r in evaluated] != [x["id"] for x in items[:len(evaluated)]]:
47:         raise ValueError("checkpoint is not a prefix of the fixed basis")
48:     sieve = RankSieve(126, prime)
49:     for row in evaluated:
50:         if not sieve.add(row["jacobian_row"]):
51:             raise ValueError("checkpoint contains dependent rows")
52:     if state["rank"] != sieve.rank or state["pivots"] != sieve.pivots:
53:         raise ValueError("checkpoint pivot metadata mismatch")
54:     # Batches bound both the submission queue and completed rows awaiting the
55:     # coordinator. Worker count is explicit because contractions can use GiB.
56:     pool = ProcessPoolExecutor(max_workers=workers) if workers > 1 else None
57:     try:
58:         for start in range(len(evaluated), len(items), workers):
59:             jobs = [(item, prime, coordinates) for item in items[start:start + workers]]
60:             output = pool.map(_job, jobs) if pool else map(_job, jobs)
61:             for result in output:
62:                 if not sieve.add(result["jacobian_row"]):
63:                     raise ValueError(f"fixed basis lost rank at {result['id']}")
64:                 evaluated.append(result)
65:                 state = {"evaluated": evaluated, "pivots": sieve.pivots, "rank": sieve.rank}
66:                 write_checkpoint(checkpoint, identity, state)
67:                 if sieve.rank % 10 == 0 or sieve.rank == 81:
68:                     print(f"p={prime} seed={seed}: {sieve.rank}/81", flush=True)
69:     finally:
70:         if pool:
71:             pool.shutdown(wait=True, cancel_futures=True)
72:     witness = make_witness(manifest, prime, seed, coordinates, evaluated)
73:     verify_witness(manifest, witness)
74:     return witness
75: 
76: 
77: def main():
78:     parser = argparse.ArgumentParser(description=__doc__)
79:     parser.add_argument("--basis", default=str(ROOT / "results/rank81_basis.json"))
80:     parser.add_argument("--out", default=str(ROOT / "results/rank81_certificate.json"))
81:     parser.add_argument("--checkpoint-dir", type=Path, default=ROOT / "work/rank81")
82:     parser.add_argument("--primes", type=int, nargs="+", default=[32749, 32719])
83:     parser.add_argument("--seeds", type=int, nargs="+", default=[20260907, 20260908])
84:     parser.add_argument("--workers", type=int, default=1)
85:     args = parser.parse_args()
86:     if args.workers < 1 or len(set(args.primes)) != len(args.primes) or len(set(args.seeds)) != len(args.seeds):
87:         parser.error("workers must be positive and primes/seeds must be distinct")
88:     manifest = json.loads(Path(args.basis).read_text())
89:     validate_basis(manifest)
90:     directions, indices = integral_directions()
91:     certificate = {"schema": 1, "basis_sha256": digest(manifest),
92:                    "coordinate_convention": "A_I = F_I for sorted 5-tuples I containing 0; F = sum_I A_I (e_I + *e_I).",
93:                    "coordinate_component_indices": indices,
94:                    "integral_directions_sha256": digest(directions.tolist()),
95:                    "proof": "Each graph is an integer polynomial in A. A nonzero 81x81 Jacobian minor modulo a prime proves generic characteristic-zero rank at least 81. The known quotient dimension supplies the upper bound; this is not a full invariant-ring presentation or a global coordinate chart.",
96:                    "upper_bound_source": "https://arxiv.org/abs/2509.14350v2",
97:                    "planned_cells": [[p, s] for p in args.primes for s in args.seeds],
98:                    "complete": False, "witnesses": []}
99:     for prime, seed in certificate["planned_cells"]:
100:         certificate["witnesses"].append(evaluate_cell(manifest, prime, seed, args.checkpoint_dir, args.workers))
101:         atomic_write_json(args.out, certificate)
102:     certificate["complete"] = True
103:     atomic_write_json(args.out, certificate)
104:     print(f"PASS: fixed 81 graphs, {len(certificate['witnesses'])} exact nonzero minors")
105: 
106: 
107: if __name__ == "__main__":
108:     main()

