FILE src/sdinv/certificate.py
1: """Self-contained exact Jacobian witnesses for the ordered graph basis.
2: 
3: All directions and polynomials are integral. A nonzero minor modulo one
4: prime therefore proves a characteristic-zero lower bound. Recomputing graph
5: contractions is a separate verification step from checking the saved matrix.
6: """
7: 
8: import hashlib
9: import json
10: from math import isqrt
11: 
12: import numpy as np
13: 
14: from .contract import CompactDerivativeBasis, value_and_jacobian_row
15: from .forms import basis_tuples, hodge_matrix, to_dense
16: from .graphs import validate_graph
17: from .modp import RankSieve
18: from .serialize import from_record
19: 
20: 
21: def digest(data):
22:     return hashlib.sha256(json.dumps(data, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
23: 
24: 
25: def require_prime(prime):
26:     # These modest primes also keep all compact linear algebra below int64.
27:     if type(prime) is not int or not 13 < prime <= 65521:
28:         raise ValueError("certificate prime must lie between 13 and 65521")
29:     if any(prime % d == 0 for d in range(2, isqrt(prime) + 1)):
30:         raise ValueError("certificate modulus is not prime")
31: 
32: 
33: def integral_directions():
34:     """Columns e_I + *e_I for lexicographic I containing the time index 0.
35: 
36:     The first 126 sorted components form an identity matrix. Thus the
37:     coordinates are exactly F_{0abcd}, with no 1/2 projector denominators.
38:     """
39:     hodge = hodge_matrix(10, 5, True, 32749)
40:     hodge = np.where(hodge > 32749 // 2, hodge - 32749, hodge)
41:     indices = [k for k, t in enumerate(basis_tuples(10, 5)) if t[0] == 0]
42:     directions = (np.eye(252, dtype=np.int64) + hodge)[:, indices]
43:     if not np.array_equal(directions[indices], np.eye(126, dtype=np.int64)):
44:         raise ValueError("unexpected self-dual coordinate convention")
45:     if not np.array_equal(hodge @ directions, directions):
46:         raise ValueError("integral directions are not self-dual")
47:     return directions, indices
48: 
49: 
50: def context(prime, coordinates):
51:     require_prime(prime)
52:     directions, indices = integral_directions()
53:     a = np.asarray(coordinates)
54:     if a.dtype.kind not in "iu":
55:         raise ValueError("point coordinates must be integers")
56:     if a.shape != (126,) or np.any(a < 0) or np.any(a >= prime):
57:         raise ValueError("point must contain 126 reduced coordinates")
58:     a = a.astype(np.int64)
59:     compact = directions @ a % prime
60:     basis = CompactDerivativeBasis(10, 5, directions, indices, prime)
61:     return to_dense(compact, 10, 5, prime), basis, compact
62: 
63: 
64: def determinant_mod(matrix, prime):
65:     """Python-integer Gaussian determinant; independent of RankSieve."""
66:     require_prime(prime)
67:     rows = [[int(x) % prime for x in row] for row in matrix]
68:     n = len(rows)
69:     if any(len(row) != n for row in rows):
70:         raise ValueError("determinant requires a square matrix")
71:     result = 1
72:     for k in range(n):
73:         pivot = next((i for i in range(k, n) if rows[i][k]), None)
74:         if pivot is None:
75:             return 0
76:         if pivot != k:
77:             rows[k], rows[pivot] = rows[pivot], rows[k]
78:             result = -result
79:         result = result * rows[k][k] % prime
80:         inverse = pow(rows[k][k], -1, prime)
81:         for i in range(k + 1, n):
82:             scale = rows[i][k] * inverse % prime
83:             for j in range(k + 1, n):
84:                 rows[i][j] = (rows[i][j] - scale * rows[k][j]) % prime
85:             rows[i][k] = 0
86:     return result % prime
87: 
88: 
89: def validate_basis(manifest):
90:     items = manifest["invariants"]
91:     if len(items) != 81 or len({x["id"] for x in items}) != 81:
92:         raise ValueError("certificate requires exactly 81 distinct invariant IDs")
93:     if [x["degree"] for x in items] != [4, 6, 6] + [8] * 6 + [10] * 12 + [12] * 60:
94:         raise ValueError("unexpected ordered degree inventory")
95:     for item in items:
96:         graph = from_record(item["graph"])
97:         validate_graph(graph, valence=5, max_mult=4)
98:         if len(graph) != item["degree"] or item["formula_sha256"] != digest(item["graph"]):
99:             raise ValueError("graph degree or formula hash mismatch")
100:         from .graphs import graph_from_label
101:         from .latex import graph_to_latex
102:         if item["adjacency_matrix"] != graph.tolist() or not np.array_equal(graph_from_label(item["label"]), graph):
103:             raise ValueError("graph representations disagree")
104:         if item["einstein_formula"] != graph_to_latex(graph):
105:             raise ValueError("Einstein formula does not match graph")
106:     return items
107: 
108: 
109: def evaluate_item(item, prime, coordinates, max_memory_bytes=2 * 1024**3):
110:     form, basis, _ = context(prime, coordinates)
111:     scalar, row = value_and_jacobian_row(from_record(item["graph"]), form, basis,
112:                                         10, 5, True, prime,
113:                                         max_memory_bytes=max_memory_bytes)
114:     if int(row @ np.asarray(coordinates, dtype=np.int64) % prime) != item["degree"] * scalar % prime:
115:         raise ValueError(f"Euler homogeneity failed for {item['id']}")
116:     return {"id": item["id"], "degree": item["degree"], "value": int(scalar),
117:             "jacobian_row": row.tolist()}
118: 
119: 
120: def make_witness(manifest, prime, seed, coordinates, evaluated):
121:     items = validate_basis(manifest)
122:     if [r["id"] for r in evaluated] != [x["id"] for x in items]:
123:         raise ValueError("evaluated rows do not match the fixed basis")
124:     form, _, compact = context(prime, coordinates)
125:     rows = np.asarray([r["jacobian_row"] for r in evaluated], dtype=np.int64)
126:     if rows.shape != (81, 126):
127:         raise ValueError("Jacobian has wrong shape")
128:     sieve, ranks = RankSieve(126, prime), {}
129:     for item, row in zip(items, rows):
130:         if not sieve.add(row):
131:             raise ValueError(f"fixed basis loses rank at {item['id']}")
132:         ranks[str(item["degree"])] = sieve.rank
133:     columns = sieve.pivots
134:     determinant = determinant_mod(rows[:, columns], prime)
135:     if not determinant:
136:         raise ValueError("minor is zero")
137:     return {"prime": prime, "seed": seed, "basis_sha256": digest(manifest),
138:             "coordinates": list(map(int, coordinates)), "selfdual_components": compact.tolist(),
139:             "invariant_ids": [x["id"] for x in items], "values": [r["value"] for r in evaluated],
140:             "jacobian": rows.tolist(), "pivot_columns": columns,
141:             "determinant_mod_p": determinant, "rank": sieve.rank,
142:             "cumulative_rank_by_degree": ranks, "euler_homogeneity": True}
143: 
144: 
145: def verify_witness(manifest, witness, recompute=False):
146:     items = validate_basis(manifest)
147:     prime = witness["prime"]
148:     require_prime(prime)
149:     if witness["basis_sha256"] != digest(manifest):
150:         raise ValueError("basis hash mismatch")
151:     if witness["invariant_ids"] != [x["id"] for x in items]:
152:         raise ValueError("invariant ordering mismatch")
153:     coordinates = witness["coordinates"]
154:     _, _, compact = context(prime, coordinates)
155:     if witness["selfdual_components"] != compact.tolist():
156:         raise ValueError("self-dual point mismatch")
157:     rows = np.asarray(witness["jacobian"])
158:     values = np.asarray(witness["values"])
159:     if rows.shape != (81, 126) or rows.dtype.kind not in "iu":
160:         raise ValueError("Jacobian must contain 81 by 126 integers")
161:     if values.shape != (81,) or values.dtype.kind not in "iu":
162:         raise ValueError("values must contain 81 integers")
163:     if np.any(rows < 0) or np.any(rows >= prime) or np.any(values < 0) or np.any(values >= prime):
164:         raise ValueError("values and rows must be reduced modulo the prime")
165:     degrees = np.asarray([x["degree"] for x in items], dtype=np.int64)
166:     if not np.array_equal(rows @ np.asarray(coordinates) % prime, degrees * values % prime):
167:         raise ValueError("Euler homogeneity mismatch")
168:     if witness.get("euler_homogeneity") is not True:
169:         raise ValueError("Euler validation metadata mismatch")
170:     columns = witness["pivot_columns"]
171:     if len(columns) != 81 or len(set(columns)) != 81 or any(type(c) is not int or not 0 <= c < 126 for c in columns):
172:         raise ValueError("invalid pivot columns")
173:     determinant = determinant_mod(rows[:, columns], prime)
174:     if determinant == 0 or determinant != witness["determinant_mod_p"]:
175:         raise ValueError("minor determinant mismatch")
176:     sieve, ranks = RankSieve(126, prime), {}
177:     for item, row in zip(items, rows):
178:         sieve.add(row)
179:         ranks[str(item["degree"])] = sieve.rank
180:     if witness["rank"] != 81 or ranks != witness["cumulative_rank_by_degree"]:
181:         raise ValueError("rank metadata mismatch")
182:     if recompute:
183:         for item, saved_row, saved_value in zip(items, rows, values):
184:             fresh = evaluate_item(item, prime, coordinates)
185:             if fresh["value"] != saved_value or fresh["jacobian_row"] != saved_row.tolist():
186:                 raise ValueError(f"graph recomputation mismatch: {item['id']}")
187:     return {"prime": prime, "seed": witness["seed"], "rank": 81,
188:             "determinant_mod_p": determinant, "graph_rows_recomputed": recompute}
