26: def rational_rank(matrix):
27:     a = [list(map(Fraction, row)) for row in matrix]
28:     rank = 0
29:     for j in range(len(a[0])):
30:         pivot = next((i for i in range(rank, len(a)) if a[i][j]), None)
31:         if pivot is None:
32:             continue
33:         a[rank], a[pivot] = a[pivot], a[rank]
34:         scale = a[rank][j]
35:         a[rank] = [x / scale for x in a[rank]]
36:         for i in range(len(a)):
37:             if i != rank:
38:                 scale = a[i][j]
39:                 a[i] = [x - scale * y for x, y in zip(a[i], a[rank])]
40:         rank += 1
41:         if rank == len(a):
42:             break
43:     return rank
44: 
45: 
46: def inverse(matrix):
47:     n = len(matrix)
48:     a = [[Fraction(x) for x in row] + [Fraction(i == j) for j in range(n)]
49:          for i, row in enumerate(matrix)]
50:     for j in range(n):
51:         pivot = next((i for i in range(j, n) if a[i][j]), None)
52:         if pivot is None:
53:             raise ValueError("rational matrix is singular")
54:         a[j], a[pivot] = a[pivot], a[j]
55:         scale = a[j][j]
56:         a[j] = [x / scale for x in a[j]]
57:         for i in range(n):
58:             if i != j:
59:                 scale = a[i][j]
60:                 a[i] = [x - scale * y for x, y in zip(a[i], a[j])]
61:     return [row[n:] for row in a]
62: 
63: 
64: def reduce_matrix(matrix, prime):
65:     return np.array([[int(x.numerator * pow(x.denominator, -1, prime) % prime)
66:                       for x in row] for row in matrix], dtype=np.int64)
